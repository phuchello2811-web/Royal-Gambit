{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "firebase-rules.json", "README.md", "tools/**", "**/.*", "**/node_modules/**"],
    "cleanUrls": false,
    "headers": [
      { "source": "sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }, { "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.@(js|css)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
      { "source": "**/*.@(wasm|png|svg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] }
    ]
  },
  "database": { "rules": "firebase-rules.json" }
}
